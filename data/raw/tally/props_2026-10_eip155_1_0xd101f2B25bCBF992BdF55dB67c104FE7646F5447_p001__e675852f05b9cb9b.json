ed description."}}, {"id": "1824607835552482851", "onchainId": "56333851958529984607159334267473760794765801691521030340475379618379295501587", "status": "executed", "quorum": null, "createdAt": "2022-06-20T11:30:03.785504Z", "chainId": "eip155:1", "governor": {"id": "eip155:1:0xd101f2B25bCBF992BdF55dB67c104FE7646F5447"}, "start": {"number": 15009598, "timestamp": "2022-07-14T00:10:59Z"}, "end": {"number": 15076059, "timestamp": "2022-07-23T05:43:11Z"}, "voteStats": [{"type": "for", "votesCount": "278324308314632876686678202", "votersCount": 4, "percent": 100}, {"type": "against", "votesCount": "0", "votersCount": 0, "percent": 0}, {"type": "abstain", "votesCount": "0", "votersCount": 0, "percent": 0}, {"type": "pendingfor", "votesCount": "0", "votersCount": 0, "percent": 0}, {"type": "pendingagainst", "votesCount": "0", "votersCount": 0, "percent": 0}, {"type": "pendingabstain", "votesCount": "0", "votersCount": 0, "percent": 0}], "events": [{"type": "created", "createdAt": "2022-06-20T11:28:57Z"}, {"type": "queued", "createdAt": "2022-07-06T11:42:19Z"}, {"type": "executed", "createdAt": "2022-07-08T11:50:48Z"}], "metadata": {"title": "Test proposal #2", "description": "Test proposal #2"}}, {"id": "1822508798623876632", "onchainId": "87901252124705311341042410280813806397992420712462581614459746008980657356212", "status": "canceled", "quorum": null, "createdAt": "2022-06-17T13:59:39.084758Z", "chainId": "eip155:1", "governor": {"id": "eip155:1:0xd101f2B25bCBF992BdF55dB67c104FE7646F5447"}, "start": {"number": 14992837, "timestamp": "2022-07-11T16:18:47Z"}, "end": {"number": 15059298, "timestamp": "2022-07-20T21:50:59Z"}, "voteStats": [{"type": "for", "votesCount": "0", "votersCount": 0, "percent": 0}, {"type": "against", "votesCount": "0", "votersCount": 0, "percent": 0}, {"type": "abstain", "votesCount": "0", "votersCount": 0, "percent": 0}, {"type": "pendingfor", "votesCount": "0", "votersCount": 0, "percent": 0}, {"type": "pendingagainst", "votesCount": "0", "vot